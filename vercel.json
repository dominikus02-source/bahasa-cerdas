{
  "regions": ["sin1"],
  "crons": [
    {
      "path": "/api/cron/pengingat-tugas",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/ajakan-harian",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/ajakan-harian",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/ajakan-harian",
      "schedule": "0 12 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "bahasacerdas.com"
        }
      ],
      "destination": "https://www.bahasacerdas.com/$1",
      "permanent": true
    },
    {
      "source": "/arena-junior",
      "destination": "/junior",
      "permanent": true
    },
    {
      "source": "/arena-junior/(.*)",
      "destination": "/junior/$1",
      "permanent": true
    }
  ]
}
