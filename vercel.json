{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.bahasacerdas.com"
        }
      ],
      "destination": "https://bahasacerdas.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "bahasacerdas.site"
        }
      ],
      "destination": "https://bahasacerdas.com/$1",
      "permanent": true
    }
  ]
}
