{
  email {$ACME_EMAIL}
  servers {
    protocols h1 h2 h3
    max_header_size 64KiB
  }
}

{$APEX_DOMAIN} {
  # Midtrans HTTP notifications do not follow 301/302/303. Serve the payment
  # webhook on the apex directly (legacy dashboard setting) and use 308 for
  # everything else so POST bodies survive any other redirect.
  handle /api/payment/webhook {
    reverse_proxy web:3000
  }

  handle {
    redir https://{$WEB_DOMAIN}{uri} 308
  }
}

{$WEB_DOMAIN} {
  encode zstd gzip

  @supabase_api path /auth/v1/* /rest/v1/* /storage/v1/* /realtime/v1/* /functions/v1/* /graphql/v1/* /platform/* /pg/*

  handle @supabase_api {
    reverse_proxy supabase-envoy:8000
  }

  handle {
    reverse_proxy web:3000 {
      # Canonicalize internal standalone-server redirect origins.
      header_down Location "^https?://0[.]0[.]0[.]0:3000/" "https://www.bahasacerdas.com/"
    }
  }

  log {
    output file /var/log/caddy/web-access.log {
      roll_size 50MiB
      roll_keep 5
      roll_keep_for 168h
    }
  }
}

{$GAME_DOMAIN} {
  encode zstd gzip

  reverse_proxy game:3001

  log {
    output file /var/log/caddy/game-access.log {
      roll_size 50MiB
      roll_keep 5
      roll_keep_for 168h
    }
  }
}

{$TEST_WEB_DOMAIN} {
  encode zstd gzip

  reverse_proxy bahasacerdas-kuis-tempur-staging-web:3000

  log {
    output file /var/log/caddy/staging-web-access.log {
      roll_size 25MiB
      roll_keep 3
      roll_keep_for 72h
    }
  }
}

{$TEST_GAME_DOMAIN} {
  encode zstd gzip

  reverse_proxy bahasacerdas-kuis-tempur-staging-game:3001

  log {
    output file /var/log/caddy/staging-game-access.log {
      roll_size 25MiB
      roll_keep 3
      roll_keep_for 72h
    }
  }
}

{$NOVELIFY_WWW_DOMAIN} {
  redir https://{$NOVELIFY_DOMAIN}{uri} permanent
}

{$NOVELIFY_DOMAIN} {
  encode zstd gzip

  reverse_proxy novelify-web:3000

  log {
    output file /var/log/caddy/novelify-access.log {
      roll_size 50MiB
      roll_keep 5
      roll_keep_for 168h
    }
  }
}

api.bahasacerdas.com {
  encode zstd gzip
  reverse_proxy supabase-envoy:8000
}

# Situs opsional (mis. JUMPA). Glob kosong = tidak ada situs tambahan.
# Caddyfile INI yang dipakai produksi (CADDYFILE_PATH di stack.env).
import /etc/caddy/conf.d/*.caddy
