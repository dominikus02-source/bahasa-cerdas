# Non-secret production stack settings.
# Copy to /opt/bahasacerdas/config/stack.env (chmod 600) on the VPS.

BC_CONFIG_DIR=/opt/bahasacerdas/config
IMAGE_TAG=local

APEX_DOMAIN=bahasacerdas.com
WEB_DOMAIN=www.bahasacerdas.com
GAME_DOMAIN=game.bahasacerdas.com
GAME_ALLOWED_ORIGINS=https://www.bahasacerdas.com,https://bahasacerdas.com
ACME_EMAIL=admin@bahasacerdas.com

# Generate on the VPS: openssl rand -hex 32
REDIS_PASSWORD=CHANGE_ME
