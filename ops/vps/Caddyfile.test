{
  email {$ACME_EMAIL}
  servers {
    protocols h1 h2 h3
  }
}

{$TEST_WEB_DOMAIN} {
  encode zstd gzip

  reverse_proxy web:3000

  log {
    output file /var/log/caddy/test-web-access.log {
      roll_size 50MiB
      roll_keep 5
      roll_keep_for 168h
    }
  }
}

{$TEST_GAME_DOMAIN} {
  encode zstd gzip

  reverse_proxy game:3001

  log {
    output file /var/log/caddy/test-game-access.log {
      roll_size 50MiB
      roll_keep 5
      roll_keep_for 168h
    }
  }
}
