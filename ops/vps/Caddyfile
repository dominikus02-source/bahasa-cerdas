{
  email {$ACME_EMAIL}
  servers {
    protocols h1 h2 h3
  }
}

{$APEX_DOMAIN} {
  redir https://{$WEB_DOMAIN}{uri} permanent
}

supabase.bahasacerdas.com {
  encode zstd gzip

  reverse_proxy supabase-envoy:8000

  log {
    output file /var/log/caddy/supabase-access.log {
      roll_size 50MiB
      roll_keep 5
      roll_keep_for 168h
    }
  }
}

{$WEB_DOMAIN} {
  encode zstd gzip

  @supabase_api path /auth/v1/* /rest/v1/* /storage/v1/* /realtime/v1/* /functions/v1/* /graphql/v1/* /platform/* /pg/*

  handle @supabase_api {
    reverse_proxy supabase-envoy:8000
  }

  handle {
    reverse_proxy web:3000
  }

  encode zstd gzip

  log {
    output file /var/log/caddy/web-access.log {
      roll_size 50MiB
      roll_keep 5
      roll_keep_for 168h
    }
  }
}

{$GAME_DOMAIN} {
  encode zstd gzip

  reverse_proxy game:3001

  log {
    output file /var/log/caddy/game-access.log {
      roll_size 50MiB
      roll_keep 5
      roll_keep_for 168h
    }
  }
}
