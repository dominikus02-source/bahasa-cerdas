generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model GameRoom {
  id                  String         @id @default(cuid())
  code                String         @unique
  name                String
  gameType            GameType       @default(KUIS_BATTLE)
  hostId              String
  status              GameRoomStatus @default(WAITING)
  category            String?
  difficulty          Difficulty     @default(MEDIUM)
  questionIds         String[]
  questionCount       Int            @default(10)
  timePerQuestion     Int            @default(20)
  currentQuestion     Int            @default(0)
  createdAt           DateTime       @default(now())
  startedAt           DateTime?
  endedAt             DateTime?
  groupId             String?        // for penilaian integration
  includeInPenilaian  Boolean        @default(false)
  penilaianKategori   String?
  results             GameResult[]
  sessions            GameSession[]

  @@index([code])
  @@index([hostId])
  @@index([groupId])
}

model GameQuestion {
  id            String           @id @default(cuid())
  gameRoomId    String?
  text          String
  audioUrl      String?
  imageUrl      String?
  passage       String?
  type          GameQuestionType @default(PILIHAN_GANDA)
  options       Json
  correctAnswer String
  explanation   String?
  difficulty    Difficulty       @default(MEDIUM)
  orderIndex    Int              @default(0)
  uploaderId    String?
  createdAt     DateTime         @default(now())
  uploader      User?            @relation(fields: [uploaderId], references: [id])

  @@index([gameRoomId])
}

model GameSession {
  id          String      @id @default(cuid())
  roomId      String
  userId      String
  playerName  String
  avatarUrl   String?
  score       Int         @default(0)
  correct     Int         @default(0)
  wrong       Int         @default(0)
  streak      Int         @default(0)
  maxStreak   Int         @default(0)
  answerTimes Int[]       @default([])
  joinedAt    DateTime    @default(now())
  finishedAt  DateTime?
  result      GameResult?
  room        GameRoom    @relation(fields: [roomId], references: [id])
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

model GameResult {
  id         String      @id @default(cuid())
  roomId     String
  userId     String
  sessionId  String      @unique
  finalScore Int         @default(0)
  rank       Int?
  correct    Int
  wrong      Int
  maxStreak  Int
  avgTime    Float
  xpEarned   Int         @default(0)
  createdAt  DateTime    @default(now())
  room       GameRoom    @relation(fields: [roomId], references: [id])
  session    GameSession @relation(fields: [sessionId], references: [id])
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([userId])
  @@index([rank, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model Community {
  id          String            @id @default(cuid())
  name        String
  description String?
  type        CommunityType     @default(MGMP)
  region      String?
  province    String?
  city        String?
  school      String?
  avatarUrl   String?
  bannerUrl   String?
  isPublic    Boolean           @default(true)
  isVerified  Boolean           @default(false)
  memberCount Int               @default(0)
  postCount   Int               @default(0)
  creatorId   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  attachments Json?
  reviewNote  String?
  reviewedAt  DateTime?
  reviewedBy  String?
  status      CommunityStatus   @default(PENDING)
  creator     User?             @relation(fields: [creatorId], references: [id])
  members     CommunityMember[]
  posts       CommunityPost[]

  @@index([type])
  @@index([isPublic])
  @@index([status])
}

model CommunityMember {
  id          String    @id @default(cuid())
  communityId String
  userId      String
  role        String    @default("member")
  joinedAt    DateTime  @default(now())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([userId])
}

model CommunityPost {
  id            String    @id @default(cuid())
  communityId   String
  userId        String
  title         String?
  content       String
  fileUrl       String?
  likesCount    Int       @default(0)
  commentsCount Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  community     Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([communityId])
  @@index([userId])
  @@index([createdAt])
}

model User {
  id                 String                  @id @default(cuid())
  supabaseId         String                  @unique
  email              String                  @unique
  fullName           String
  avatar             String?
  emailConfirmed     Boolean                 @default(false)
  onboarded          Boolean                 @default(false)
  role               Role                    @default(MURID)
  isFounder          Boolean                 @default(false)
  premiumPlan        PremiumPlan             @default(FREE)
  premiumUntil       DateTime?
  isPremium          Boolean                 @default(false)
  midtransCustomerId String?
  trialStartedAt     DateTime?
  trialEndsAt        DateTime?
  trialPlan          String?                 // "GURU_PRO_TRIAL" if trial is active
  trialCreditsTotal  Int?                    // total credits allocated for trial
  xp                 Int                     @default(0)
  level              Int                     @default(1)
  streak             Int                     @default(0)
  lastActiveAt       DateTime?
  league             LeagueType              @default(BRONZE)
  saldo              Int                     @default(0)
  totalEarned        Int                     @default(0)
  coins              Int                     @default(0)
  totalLikes         Int                     @default(0)
  totalViews         Int                     @default(0)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  aiUsage            AIUsage[]
  aiCreditLedger     AiCreditLedger[]
  artikel            Artikel[]
  uploadedBankSoals  BankSoal[]
  certificates       Certificate[]
  createdCommunities Community[]
  komunitas          CommunityMember[]
  communityPosts     CommunityPost[]
  playlists          CoursePlaylist[]
  gameQuestions      GameQuestion[]
  gameResults        GameResult[]
  gameSessions       GameSession[]
  generatedRPPs      GeneratedRPP[]
  aiJobs             AIJob[]
  aiSavedResults     AiSavedResult[]
  groups             Group[]
  groupMemberships   GroupMember[]
  groupQuizResults   GroupQuizResult[]
  karya              Karya[]
  studentKarya       StudentKarya[]
  studentKaryaLikes  StudentKaryaLike[]
  studentKaryaComments StudentKaryaComment[]
  koleksiKata        KoleksiKata[]
  competencyCerts    KompetensiCertificate[]
  loker              Loker[]
  lombaPeserta       LombaPeserta[]
  uploadedMateris    Materi[]
  materiDownloads    MateriDownload[]
  notifications      Notifikasi[]
  competencyPackets  PaketKompetensi[]
  purchases          Pembelian[]
  profile            Profile?
  competencyResults  ProgresKompetensi[]
  purchasesHistory   PurchaseHistory[]
  quizzes            Quiz[]
  quizSessions       QuizSession[]
  quizSubmissions    QuizSubmission[]
  uploadedRPPs       RPP[]
  sellerEarnings     SellerEarning[]
  soals              Soal[]
  soalSets           SoalSet[]
  tkaQuestions       TKAQuestion[]
  testAnswers        TestAnswer[]
  testSessions       TestSession[]
  transaksi          Transaksi[]
  ukbiQuestions      UKBIQuestion[]
  videos             Video[]
  withdrawals        Withdrawal[]
  coinTransactions   CoinTransaction[]
  dailyQuests        DailyQuest[]
  userItems          UserItem[]
  chatMessages       ChatMessage[]
  unitProgress       UserUnitProgress[]
  penugasans         Penugasan[]
  penugasanSubmissions PenugasanSubmission[]
  nilais             Nilai[]
  subscriptions      Subscription[]

  // Admin quota audit logs where this user was the acting admin
  adminQuotaActions  AdminQuotaAuditLog[] @relation("AdminActions")
  // Admin quota audit logs where this user was the target
  targetOfQuotaActions AdminQuotaAuditLog[] @relation("TargetActions")
  // Admin payment audit logs where this user was the acting admin
  paymentAdminActions  AdminPaymentAuditLog[] @relation("PaymentAdminActions")
  // Admin payment audit logs where this user was the target
  paymentTargetActions AdminPaymentAuditLog[] @relation("PaymentTargetActions")
  // Backup manifests created by this user
  backupManifests    BackupManifest[] @relation("UserBackupManifests")

  @@index([role, lastActiveAt])
  @@index([xp])
  @@index([supabaseId])
  @@index([email])
}

model Profile {
  id         String   @id @default(cuid())
  userId     String   @unique
  bio        String?
  nip        String?
  nuptk      String?
  nisn       String?
  school     String?
  city       String?
  province   String?
  subject    String?
  grade      String?
  className  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  bank       String?
  bankHolder String?
  bankNumber String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UKBIQuestion {
  id            String             @id @default(cuid())
  seksi         UKBISeksi
  text          String
  audioUrl      String?
  imageUrl      String?
  passage       String?
  type          String             @default("PILIHAN_GANDA")
  options       Json
  correctAnswer String
  explanation   String?
  difficulty    Difficulty         @default(MEDIUM)
  cognitive     CognitiveDimension @default(PENERAPAN)
  domain        KommunikasDomain   @default(SOSIAL)
  passageType   String?
  wordCount     Int?
  keywords      String[]
  isActive      Boolean            @default(true)
  isVerified    Boolean            @default(false)
  uploaderId    String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  tingkat       Tingkat            @default(UMUM)
  uploader      User?              @relation(fields: [uploaderId], references: [id])

  @@index([seksi, isActive])
  @@index([difficulty])
  @@index([isVerified])
  @@index([tingkat])
}

model TKAQuestion {
  id            String        @id @default(cuid())
  kompetensi    TKAKompetensi
  subKompetensi String?
  text          String
  passage       String?
  type          String        @default("PILIHAN_GANDA")
  options       Json
  correctAnswer String
  explanation   String?
  difficulty    Difficulty    @default(MEDIUM)
  weight        Float         @default(1.0)
  year          Int?
  source        String?
  isActive      Boolean       @default(true)
  isVerified    Boolean       @default(false)
  uploaderId    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  tingkat       Tingkat       @default(UMUM)
  uploader      User?         @relation(fields: [uploaderId], references: [id])

  @@index([kompetensi, isActive])
  @@index([difficulty])
  @@index([isVerified])
  @@index([tingkat])
}

model PaketKompetensi {
  id             String                  @id @default(cuid())
  title          String
  description    String?
  type           KompetensiType
  mode           TestMode                @default(SIMULASI)
  duration       Int
  passingScore   Int                     @default(0)
  passingGrade   String                  @default("D")
  sections       Json
  totalQuestions Int                     @default(0)
  isActive       Boolean                 @default(true)
  isPremium      Boolean                 @default(false)
  thumbnailUrl   String?
  attemptLimit   Int                     @default(-1)
  sectionsData   Json?
  questionPool   Json?
  creatorId      String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  certificates   KompetensiCertificate[]
  creator        User?                   @relation(fields: [creatorId], references: [id])
  results        ProgresKompetensi[]
  testSessions   TestSession[]

  @@index([type, isActive])
  @@index([type, isActive, createdAt])
}

model ProgresKompetensi {
  id            String          @id @default(cuid())
  userId        String
  paketId       String
  attemptNumber Int             @default(1)
  status        TestStatus      @default(NOT_STARTED)
  totalScore    Int?
  rawScore      Int?
  maxScore      Int?
  percentage    Float?
  predikat      String?
  predikatLama  String?
  sectionScores Json?
  seksiScores   Json?
  answerDetails Json?
  startedAt     DateTime        @default(now())
  finishedAt    DateTime?
  timeSpent     Int?
  paket         PaketKompetensi @relation(fields: [paketId], references: [id])
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, paketId, attemptNumber])
  @@index([userId])
  @@index([paketId])
}

model KompetensiCertificate {
  id            String          @id @default(cuid())
  userId        String
  paketId       String
  progresId     String
  score         Int
  predikat      String
  percentage    Float
  qrCode        String?
  certificateNo String          @unique
  pdfUrl        String?
  issuedAt      DateTime        @default(now())
  expiresAt     DateTime?
  paket         PaketKompetensi @relation(fields: [paketId], references: [id])
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TestSession {
  id              String          @id @default(cuid())
  userId          String
  paketId         String
  status          TestStatus      @default(NOT_STARTED)
  currentSection  Int             @default(0)
  currentQuestion Int             @default(0)
  answers         Json            @default("{}")
  questionSnapshot Json?
  flagged         Int[]           @default([])
  startedAt       DateTime?
  finishedAt      DateTime?
  expiresAt       DateTime?
  createdAt       DateTime        @default(now())
  paket           PaketKompetensi @relation(fields: [paketId], references: [id])
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, paketId])
  @@index([userId])
  @@index([paketId])
}

model TestAnswer {
  id           String   @id @default(cuid())
  userId       String
  sessionId    String?
  paketId      String?
  questionId   String?
  questionType String?
  answer       String?
  isCorrect    Boolean?
  score        Float    @default(0)
  timeSpent    Int      @default(0)
  seksi        String?
  sectionIndex Int      @default(0)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, paketId])
  @@index([sessionId])
}

model Materi {
  id          String    @id @default(cuid())
  title       String
  description String?
  content     String
  fileUrl     String?
  fileKey     String?
  fileType    FileType?
  grade       String?
  semester    Int?
  tahunAjaran String?
  tema        String?
  subtema     String?
  isPublished Boolean   @default(false)
  isPremium   Boolean   @default(false)
  price       Int       @default(0)
  downloads   Int       @default(0)
  subject     String?
  uploaderId  String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  uploader    User      @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  downloadRecords MateriDownload[]

  @@index([uploaderId])
  @@index([isPublished])
}

// Catatan unduhan per user — untuk batas unduh (gratis 10 modul, premium tak terbatas).
model MateriDownload {
  id        String   @id @default(cuid())
  userId    String
  materiId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  materi    Materi   @relation(fields: [materiId], references: [id], onDelete: Cascade)

  @@unique([userId, materiId])
  @@index([userId])
  @@index([materiId])
}

model BankSoal {
  id          String     @id @default(cuid())
  title       String
  description String?
  type        String     @default("PILIHAN_GANDA")
  difficulty  Difficulty @default(MEDIUM)
  kelas       String
  semester    Int?
  tahunAjaran String?
  KD          String?
  isHOTS      Boolean    @default(false)
  jumlahSoal  Int        @default(10)
  fileUrl     String
  fileKey     String?
  fileType    FileType   @default(PDF)
  isPublished Boolean    @default(false)
  isPremium   Boolean    @default(false)
  price       Int        @default(0)
  downloads   Int        @default(0)
  subject     String     @default("Bahasa Indonesia")
  uploaderId  String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  uploader    User       @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  soals       Soal[]

  @@index([uploaderId])
  @@index([isPublished])
}

model Soal {
  id            String    @id @default(cuid())
  text          String
  type          String    @default("PILIHAN_GANDA")
  difficulty    String    @default("MEDIUM")
  options       String[]
  correctAnswer String
  explanation   String?
  isHOTS        Boolean   @default(false)
  kelas         String
  topik         String?
  KD            String?
  subject       String    @default("Bahasa Indonesia")
  source        String    @default("MANUAL")
  bankSoalId    String?
  soalSetId     String?
  uploaderId    String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  bankSoal      BankSoal? @relation(fields: [bankSoalId], references: [id])
  soalSet       SoalSet?  @relation(fields: [soalSetId], references: [id])
  uploader      User      @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([uploaderId])
  @@index([kelas])
  @@index([topik])
  @@index([source])
  @@index([soalSetId])
}

model SoalSet {
  id           String   @id @default(cuid())
  title        String
  description  String?
  coverColor   String   @default("from-violet-500 to-purple-600")
  coverEmoji   String?
  kelas        String
  topik        String?
  subject      String   @default("Bahasa Indonesia")
  maxQuestions Int      @default(50)
  isPublic     Boolean  @default(false)
  creatorId    String
  useCount     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  questions    Soal[]
  creator      User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
  @@index([kelas])
  @@index([topik])
  @@index([isPublic])
}

model RPP {
  id          String   @id @default(cuid())
  title       String
  description String?
  kelas       String
  semester    Int
  tahunAjaran String
  fase        String?
  week        Int?
  theme       String?
  subTheme    String?
  fileUrl     String
  fileKey     String?
  fileType    FileType @default(PDF)
  isPublished Boolean  @default(false)
  isPremium   Boolean  @default(false)
  price       Int      @default(0)
  downloads   Int      @default(0)
  subject     String   @default("Bahasa Indonesia")
  uploaderId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  uploader    User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([uploaderId])
  @@index([isPublished])
}

model GeneratedRPP {
  id          String   @id @default(cuid())
  type        String   @default("RPP")
  title       String
  description String?
  kelas       String
  semester    String   @default("1 (Ganjil)")
  tahunAjaran String   @default("2025/2026")
  subject     String   @default("Bahasa Indonesia")
  curriculum  String   @default("MERDEKA")
  schoolInfo  Json?
  kds         String[]
  methods     String[]
  content     Json
  isPublished Boolean  @default(false)
  uploaderId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  uploader    User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([uploaderId])
  @@index([type])
}

model AIJob {
  id          String   @id @default(cuid())
  userId      String
  type        String                        // "RPP", "SOAL", "PPT"
  status      String   @default("PENDING")  // PENDING, PROCESSING, COMPLETED, FAILED
  input       Json
  output      Json?
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model AiSavedResult {
  id            String    @id @default(cuid())
  userId        String
  agentId       String
  title         String
  inputJson     Json
  outputJson    Json
  editableText  String?
  qualityScore  Int?
  provider      String?
  model         String?
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, agentId, createdAt])
  @@index([userId, createdAt])
}

model Video {
  id           String          @id @default(cuid())
  title        String
  description  String?
  videoUrl     String
  thumbnailUrl String?
  duration     Int?
  source       VideoSource     @default(YOUTUBE)
  category     VideoCategory   @default(PEMBELAJARAN)
  grade        String?
  tags         String[]
  isPublished  Boolean         @default(false)
  isPremium    Boolean         @default(false)
  price        Int             @default(0)
  views        Int             @default(0)
  playlistId   String?
  creatorId    String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  creator      User?           @relation(fields: [creatorId], references: [id])
  playlist     CoursePlaylist? @relation(fields: [playlistId], references: [id])

  @@index([isPublished])
  @@index([category])
  @@index([creatorId])
  @@index([playlistId])
  @@index([isPublished, views])
  @@index([isPublished, category, createdAt])
}

model CoursePlaylist {
  id           String        @id @default(cuid())
  title        String
  description  String?
  thumbnailUrl String?
  category     VideoCategory @default(PEMBELAJARAN)
  grade        String?
  isPublished  Boolean       @default(false)
  creatorId    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  creator      User?         @relation(fields: [creatorId], references: [id])
  videos       Video[]

  @@index([isPublished])
}

model Karya {
  id          String      @id @default(cuid())
  title       String
  description String
  type        KaryaType
  fileUrl     String
  fileKey     String?
  fileType    FileType?
  price       Int         @default(0)
  isPublished Boolean     @default(false)
  isPremium   Boolean     @default(false)
  downloads   Int         @default(0)
  grade       String?
  subject     String?
  week        Int?
  sellerId    String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  images      String      @default("[]")
  seller      User        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  purchases   Pembelian[]

  @@index([sellerId])
  @@index([isPublished])
  @@index([downloads])
}

model StudentKarya {
  id         String                @id @default(cuid())
  userId     String
  title      String
  content    String
  excerpt    String?
  type       StudentKaryaType
  coverImage String?
  likesCount Int                   @default(0)
  viewsCount Int                   @default(0)
  isFeatured Boolean               @default(false)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes    StudentKaryaLike[]
  comments StudentKaryaComment[]

  @@index([type])
  @@index([createdAt])
  @@index([likesCount])
  @@index([userId])
}

model StudentKaryaLike {
  id        String   @id @default(cuid())
  karyaId   String
  userId    String
  createdAt DateTime @default(now())

  karya StudentKarya @relation(fields: [karyaId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([karyaId, userId])
  @@index([karyaId])
  @@index([userId])
}

model StudentKaryaComment {
  id        String   @id @default(cuid())
  karyaId   String
  userId    String
  content   String
  createdAt DateTime @default(now())

  karya StudentKarya @relation(fields: [karyaId], references: [id], onDelete: Cascade)
