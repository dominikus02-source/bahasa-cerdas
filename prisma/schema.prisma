generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GURU
  MURID
  ADMIN
}

enum PremiumPlan {
  FREE
  PRO
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  VERY_HARD
}

enum KaryaType {
  RPP
  MODUL
  PPT
  SOAL
  VIDEO
  EBOOK
  ADMINISTRASI
  LAINNYA
}

enum LeagueType {
  BRONZE
  SILVER
  GOLD
  DIAMOND
}

enum KompetensiType {
  UKBI
  UKBI_SIMULASI
  UKBI_LATIHAN
  TKA_GURU
  TKA_UTBK
  SERTIFIKAT
}

enum LombaStatus {
  OPEN
  CLOSED
  UPCOMING
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
}

enum KoleksiRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum VideoSource {
  YOUTUBE
  VIMEO
  UPLOAD
}

enum VideoCategory {
  PEMBELAJARAN
  GRAMMATIKA
  SASTRA
  WRITING
  SPEAKING
  READING
  MEDIA
  UKBI_PREP
  LAINNYA
}

enum WithdrawStatus {
  PENDING
  APPROVED
  REJECTED
  TRANSFERRED
}

enum FileType {
  PDF
  DOCX
  PPTX
  XLSX
  MP4
  ZIP
}

enum UKBISeksi {
  MENDENGARKAN
  MERESPONS_KAIDAH
  MEMBACA
  MENULIS
  BERBICARA
}

enum CognitiveDimension {
  MENGINGAT
  PEMAHAMAN
  PENERAPAN
  ANALISIS
  EVALUASI
  KREASI
}

enum KommunikasDomain {
  SINTAS
  SOSIAL
  VOKASIONAL
  AKADEMIK
}

enum TKAKompetensi {
  PEDAGOGIK
  PROFESIONAL
  SOSIAL
  KEPRIBADIAN
}

enum TestMode {
  SIMULASI
  LATIHAN
  UJIAN
}

enum TestStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

enum CommunityType {
  MGMP
  KKG
  PUBLIKASI
  STUDY_GROUP
  LAINNYA
}

enum CommunityStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GameType {
  KUIS_BATTLE
  TEBAC_KATA
  KOSAKATA_HARIAN
  KATA_SERU
}

enum GameRoomStatus {
  WAITING
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum GameQuestionType {
  PILIHAN_GANDA
  ISIAN_SINGKAT
  BENAR_SALAH
}

model GameRoom {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  gameType    GameType @default(KUIS_BATTLE)
  hostId      String

  status      GameRoomStatus @default(WAITING)
  category    String?
  difficulty  Difficulty     @default(MEDIUM)

  questionIds String[]
  questionCount Int           @default(10)
  timePerQuestion Int        @default(20)

  currentQuestion Int         @default(0)

  sessions     GameSession[]
  results      GameResult[]

  createdAt DateTime @default(now())
  startedAt DateTime?
  endedAt   DateTime?

  @@index([code])
  @@index([hostId])
}

model GameQuestion {
  id          String   @id @default(cuid())
  gameRoomId  String?

  text        String
  audioUrl    String?
  imageUrl    String?
  passage     String?
  type        GameQuestionType @default(PILIHAN_GANDA)
  options     Json
  correctAnswer String

  explanation String?
  difficulty  Difficulty @default(MEDIUM)

  orderIndex  Int       @default(0)

  uploaderId String?
  uploader   User?   @relation(fields: [uploaderId], references: [id])

  createdAt DateTime @default(now())

  @@index([gameRoomId])
}

model GameSession {
  id        String   @id @default(cuid())
  roomId    String
  room      GameRoom  @relation(fields: [roomId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  playerName String
  avatarUrl  String?
  score      Int      @default(0)
  correct    Int      @default(0)
  wrong      Int      @default(0)
  streak     Int      @default(0)
  maxStreak  Int      @default(0)
  answerTimes Int[]   @default([])

  joinedAt  DateTime @default(now())
  finishedAt DateTime?

  result    GameResult?

  @@unique([roomId, userId])
  @@index([userId])
}

model GameResult {
  id        String   @id @default(cuid())
  roomId    String
  room      GameRoom @relation(fields: [roomId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String   @unique
  session   GameSession @relation(fields: [sessionId], references: [id])

  finalScore Int     @default(0)
  rank       Int?
  correct    Int
  wrong      Int
  maxStreak  Int
  avgTime    Float
  xpEarned   Int     @default(0)

  createdAt DateTime @default(now())

  @@index([roomId])
  @@index([userId])
}

model Community {
  id          String        @id @default(cuid())
  name        String
  description String?
  type        CommunityType @default(MGMP)
  region      String?
  province    String?
  city        String?
  school      String?
  avatarUrl   String?
  bannerUrl   String?
  isPublic    Boolean       @default(true)
  isVerified  Boolean       @default(false)
  status      CommunityStatus @default(PENDING)
  reviewNote  String?
  reviewedBy  String?
  reviewedAt  DateTime?
  attachments Json?
  memberCount Int           @default(0)
  postCount   Int           @default(0)

  creatorId String?
  creator   User?   @relation(fields: [creatorId], references: [id])

  members CommunityMember[]
  posts   CommunityPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([isPublic])
  @@index([status])
}

model CommunityMember {
  id           String    @id @default(cuid())
  communityId  String
  community    Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         String    @default("member")
  joinedAt     DateTime  @default(now())

  @@unique([communityId, userId])
  @@index([userId])
}

model CommunityPost {
  id           String    @id @default(cuid())
  communityId  String
  community    Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  title        String?
  content      String
  fileUrl      String?
  likesCount   Int       @default(0)
  commentsCount Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([communityId])
  @@index([userId])
}

model User {
  id         String  @id @default(cuid())
  supabaseId String  @unique
  email      String  @unique
  fullName   String
  avatar     String?
  role       Role    @default(MURID)
  isFounder  Boolean @default(false)

  premiumPlan        PremiumPlan @default(FREE)
  premiumUntil       DateTime?
  isPremium          Boolean      @default(false)
  midtransCustomerId String?

  xp           Int        @default(0)
  level        Int        @default(1)
  streak       Int        @default(0)
  lastActiveAt DateTime?
  league       LeagueType @default(BRONZE)

  saldo       Int @default(0)
  totalEarned Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile            Profile?
  karya              Karya[]
  purchases          Pembelian[]
  uploadedMateris    Materi[]
  uploadedRPPs       RPP[]
  generatedRPPs      GeneratedRPP[]
  uploadedBankSoals  BankSoal[]
  soals              Soal[]
  withdrawals        Withdrawal[]
  sellerEarnings     SellerEarning[]
  purchasesHistory   PurchaseHistory[]
  testSessions      TestSession[]
  testAnswers       TestAnswer[]
  ukbiQuestions     UKBIQuestion[]
  tkaQuestions      TKAQuestion[]
  competencyPackets  PaketKompetensi[]
  competencyResults  ProgresKompetensi[]
  competencyCerts   KompetensiCertificate[]
  videos            Video[]
  playlists          CoursePlaylist[]
  notifications     Notifikasi[]
  quizSessions      QuizSession[]
  certificates      Certificate[]
  koleksiKata       KoleksiKata[]
  lombaPeserta      LombaPeserta[]
  aiUsage           AIUsage[]
  komunitas         CommunityMember[]
  communityPosts    CommunityPost[]
  createdCommunities Community[]
  groups            Group[]
  groupMemberships  GroupMember[]
  groupQuizResults  GroupQuizResult[]
  transaksi          Transaksi[]

  gameQuestions     GameQuestion[]
  gameSessions      GameSession[]
  gameResults       GameResult[]

  artikel           Artikel[]
  loker             Loker[]
}

model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio       String?
  nip       String?
  nuptk     String?
  nisn      String?
  school    String?
  subject   String?
  grade     String?
  className String?
  bank      String?
  bankHolder String?
  bankNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UKBIQuestion {
  id          String   @id @default(cuid())
  seksi       UKBISeksi
  text        String
  audioUrl    String?
  imageUrl    String?
  passage     String?
  type        String   @default("PILIHAN_GANDA")
  options     Json
  correctAnswer String
  explanation String?
  difficulty  Difficulty @default(MEDIUM)
  cognitive   CognitiveDimension @default(PENERAPAN)
  domain      KommunikasDomain @default(SOSIAL)
  passageType String?
  wordCount   Int?
  keywords    String[]
  isActive    Boolean  @default(true)
  isVerified  Boolean  @default(false)

  uploaderId String?
  uploader   User?   @relation(fields: [uploaderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([seksi, isActive])
  @@index([difficulty])
  @@index([isVerified])
}

model TKAQuestion {
  id          String         @id @default(cuid())
  kompetensi  TKAKompetensi
  subKompetensi String?
  text        String
  passage     String?
  type        String         @default("PILIHAN_GANDA")
  options     Json
  correctAnswer String
  explanation String?
  difficulty  Difficulty     @default(MEDIUM)
  weight      Float          @default(1.0)
  year        Int?
  source      String?
  isActive    Boolean        @default(true)
  isVerified  Boolean        @default(false)

  uploaderId String?
  uploader   User?   @relation(fields: [uploaderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kompetensi, isActive])
  @@index([difficulty])
  @@index([isVerified])
}

model PaketKompetensi {
  id           String         @id @default(cuid())
  title        String
  description  String?
  type         KompetensiType
  mode         TestMode       @default(SIMULASI)
  duration     Int
  passingScore Int            @default(0)
  passingGrade String         @default("D")
  sections     Json
  totalQuestions Int           @default(0)
  isActive     Boolean        @default(true)
  isPremium    Boolean        @default(false)
  thumbnailUrl String?
  attemptLimit Int            @default(-1)

  sectionsData Json?
  questionPool Json?

  creatorId String?
  creator   User?   @relation(fields: [creatorId], references: [id])

  results  ProgresKompetensi[]
  certificates KompetensiCertificate[]
  testSessions TestSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, isActive])
}

model ProgresKompetensi {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  paketId   String
  paket     PaketKompetensi @relation(fields: [paketId], references: [id])

  attemptNumber Int       @default(1)
  status       TestStatus @default(NOT_STARTED)

  totalScore     Int?
  rawScore       Int?
  maxScore       Int?
  percentage     Float?
  predikat       String?
  predikatLama   String?

  sectionScores Json?
  seksiScores  Json?
  answerDetails Json?

  startedAt   DateTime  @default(now())
  finishedAt DateTime?
  timeSpent  Int?

  @@unique([userId, paketId, attemptNumber])
  @@index([userId])
}

model KompetensiCertificate {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  paketId   String
  paket     PaketKompetensi @relation(fields: [paketId], references: [id])
  progresId String

  score         Int
  predikat      String
  percentage    Float
  qrCode        String?
  certificateNo String     @unique
  pdfUrl        String?
  issuedAt      DateTime   @default(now())
  expiresAt     DateTime?

  @@index([userId])
}

model TestSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  paketId   String
  paket     PaketKompetensi @relation(fields: [paketId], references: [id])

  status    TestStatus @default(NOT_STARTED)

  currentSection Int     @default(0)
  currentQuestion Int    @default(0)
  answers        Json    @default("{}")
  flagged        Int[]   @default([])

  startedAt  DateTime?
  finishedAt DateTime?
  expiresAt  DateTime?

  createdAt DateTime @default(now())

  @@unique([userId, paketId])
  @@index([userId])
}

model TestAnswer {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  sessionId String?
  paketId  String?

  questionId   String?
  questionType String?
  answer       String?
  isCorrect    Boolean?
  score        Float     @default(0)
  timeSpent    Int       @default(0)

  seksi       String?
  sectionIndex Int      @default(0)

  createdAt DateTime @default(now())

  @@index([userId, paketId])
}

model Materi {
  id          String   @id @default(cuid())
  title       String
  description String?
  content     String
  fileUrl     String?
  fileKey     String?
  fileType    FileType?
  grade       String?
  semester    Int?
  tahunAjaran String?
  tema        String?
  subtema     String?
  isPublished Boolean  @default(false)
  isPremium   Boolean  @default(false)
  price       Int      @default(0)
  downloads   Int      @default(0)
  subject     String?

  uploaderId String
  uploader   User   @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([uploaderId])
  @@index([isPublished])
}

model BankSoal {
  id          String     @id @default(cuid())
  title       String
  description String?
  type        String     @default("PILIHAN_GANDA")
  difficulty  Difficulty @default(MEDIUM)
  kelas       String
  semester    Int?
  tahunAjaran String?
  KD          String?
  isHOTS      Boolean    @default(false)
  jumlahSoal  Int        @default(10)
  fileUrl     String
  fileKey     String?
  fileType    FileType   @default(PDF)
  isPublished Boolean    @default(false)
  isPremium   Boolean    @default(false)
  price       Int        @default(0)
  downloads   Int        @default(0)
  subject     String     @default("Bahasa Indonesia")

  uploaderId String
  uploader   User   @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  soals      Soal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([uploaderId])
  @@index([isPublished])
}

model Soal {
  id            String   @id @default(cuid())
  text          String
  type          String   @default("PILIHAN_GANDA")
  difficulty    String   @default("MEDIUM")
  options       String[]
  correctAnswer String
  explanation   String?
  isHOTS        Boolean  @default(false)
  kelas         String
  topik         String?
  KD            String?
  subject       String   @default("Bahasa Indonesia")
  source        String   @default("MANUAL")
  bankSoalId    String?
  bankSoal      BankSoal? @relation(fields: [bankSoalId], references: [id], onDelete: SetNull)
  uploaderId    String
  uploader      User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([uploaderId])
  @@index([kelas])
  @@index([topik])
  @@index([source])
}

model RPP {
  id          String   @id @default(cuid())
  title       String
  description String?
  kelas       String
  semester    Int
  tahunAjaran String
  fase        String?
  week        Int?
  theme       String?
  subTheme    String?
  fileUrl     String
  fileKey     String?
  fileType    FileType @default(PDF)
  isPublished Boolean  @default(false)
  isPremium   Boolean  @default(false)
  price       Int      @default(0)
  downloads   Int      @default(0)
  subject     String   @default("Bahasa Indonesia")

  uploaderId String
  uploader   User   @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([uploaderId])
  @@index([isPublished])
}

model GeneratedRPP {
  id          String   @id @default(cuid())
  type        String   @default("RPP")
  title       String
  description String?
  kelas       String
  semester    String   @default("1 (Ganjil)")
  tahunAjaran String   @default("2025/2026")
  subject     String   @default("Bahasa Indonesia")
  curriculum  String   @default("MERDEKA")
  schoolInfo  Json?
  kds         String[]
  methods     String[]
  content     Json
  isPublished Boolean  @default(false)
  uploaderId  String
  uploader    User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([uploaderId])
  @@index([type])
}

model Video {
  id           String       @id @default(cuid())
  title        String
  description  String?
  videoUrl     String
  thumbnailUrl String?
  duration     Int?
  source       VideoSource  @default(YOUTUBE)
  category     VideoCategory @default(PEMBELAJARAN)
  grade        String?
  tags         String[]
  isPublished  Boolean      @default(false)
  isPremium    Boolean       @default(false)
  price        Int           @default(0)
  views        Int           @default(0)

  playlistId String?
  playlist   CoursePlaylist? @relation(fields: [playlistId], references: [id])
  creatorId  String?
  creator   User?           @relation(fields: [creatorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished])
  @@index([category])
}

model CoursePlaylist {
  id           String  @id @default(cuid())
  title        String
  description  String?
  thumbnailUrl String?
  category     VideoCategory @default(PEMBELAJARAN)
  grade        String?
  isPublished  Boolean @default(false)
  creatorId    String?

  videos    Video[]
  creator   User?   @relation(fields: [creatorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished])
}

model Karya {
  id          String    @id @default(cuid())
  title       String
  description String
  type        KaryaType
  fileUrl     String
  fileKey     String?
  fileType    FileType?
  price       Int       @default(0)
  isPublished Boolean   @default(false)
  isPremium   Boolean   @default(false)
  downloads   Int       @default(0)
  grade       String?
  subject     String?
  week        Int?
  images      String  @default("[]")

  sellerId String
  seller   User   @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  purchases Pembelian[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([sellerId])
  @@index([isPublished])
}

model Pembelian {
  id      String @id @default(cuid())
  karyaId String
  karya   Karya  @relation(fields: [karyaId], references: [id])
  buyerId String
  buyer   User   @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  amount        Int
  platformFee   Int
  sellerEarning Int

  status OrderStatus @default(PENDING)

  midtransOrderId      String?   @unique
  midtransPaymentType   String?
  midtransStatus        String?
  midtransPaymentAmount Int?
  midtransPaidAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseHistory {
  id         String   @id @default(cuid())
  buyerId    String
  buyer      User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  itemType   String
  itemId     String
  itemTitle  String
  fileUrl    String
  fileKey    String?
  price      Int
  soldAt     DateTime @default(now())
}

model SellerEarning {
  id         String   @id @default(cuid())
  sellerId   String
  seller     User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  itemType   String
  itemId     String
  itemTitle  String
  grossAmount Int
  platformFee Int
  netAmount  Int
  status     String   @default("PENDING")
  soldAt     DateTime @default(now())

  @@index([sellerId])
}

model Withdrawal {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  bankName  String
  accountNumber String
  accountHolder String
  status    WithdrawStatus  @default(PENDING)
  notes     String?
  processedAt DateTime?
  transferProof String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model QuizSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId String?
  title  String
  mode   String @default("practice")

  answers Json @default("[]")
  score   Int?
  status  String @default("IN_PROGRESS")

  startedAt  DateTime @default(now())
  finishedAt DateTime?

  @@index([userId])
}

model Certificate {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  score     Int
  pdfUrl    String?
  issuedAt  DateTime    @default(now())

  @@index([userId])
}

model KoleksiKata {
  id       String        @id @default(cuid())
  userId   String
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kata     String
  definisi String?
  contoh   String?
  rarity   KoleksiRarity @default(COMMON)

  createdAt DateTime @default(now())
}

model Lomba {
  id                   String      @id @default(cuid())
  title                String
  description          String
  type                 String
  level                String
  date                 DateTime
  registrationDeadline DateTime?
  prize                String?
  rules                String?
  posterUrl            String?
  location             String?
  contact              String?
  registrationUrl      String?
  status               LombaStatus @default(UPCOMING)

  peserta LombaPeserta[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LombaPeserta {
  id      String @id @default(cuid())
  lombaId String
  lomba   Lomba  @relation(fields: [lombaId], references: [id])
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  score   Int?
  rank    Int?
  status  String @default("registered")

  createdAt DateTime @default(now())

  @@unique([lombaId, userId])
}

enum LokerStatus {
  OPEN
  CLOSED
}

model Loker {
  id              String      @id @default(cuid())
  title           String
  sekolah         String
  lokasi          String
  description     String
  requirements    String?
  salary          String?
  type            String?     @default("FULL_TIME")
  contact         String?
  applicationUrl  String?
  status          LokerStatus @default(OPEN)
  isApproved      Boolean     @default(false)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, isApproved])
  @@index([createdAt])
}

model AIUsage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  feature String
  tokens  Int    @default(0)
  costUSD Float  @default(0)
  bulan   String

  createdAt DateTime @default(now())

  @@index([userId, feature, bulan])
}

model Transaksi {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String
  amount    Int
  status    String  @default("PENDING")
  reference String?
  orderId   String?
  midtransId String?
  metadata  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notifikasi {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title  String
  body   String
  type   String
  isRead Boolean @default(false)
  data   Json?

  createdAt DateTime @default(now())
}

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  grade       String
  tahunAjaran String?
  accessCode  String   @unique
  isActive    Boolean  @default(true)

  teacherId String
  teacher   User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  members  GroupMember[]
  quizzes  GroupQuiz[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
  @@index([accessCode])
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId])
}

model GroupQuiz {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  quizId    String
  title     String
  assignedAt DateTime @default(now())
  dueDate   DateTime?
  results   GroupQuizResult[]

  @@index([groupId])
}

model GroupQuizResult {
  id           String    @id @default(cuid())
  groupQuizId  String
  groupQuiz    GroupQuiz @relation(fields: [groupQuizId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  score        Int?
  status       String     @default("ASSIGNED")
  startedAt    DateTime?
  finishedAt   DateTime?

  @@unique([groupQuizId, userId])
  @@index([userId])
}

model Artikel {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String
  excerpt     String?
  coverImage  String?
  tags        String[]
  isPublished Boolean  @default(false)
  readCount   Int      @default(0)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, createdAt])
  @@index([authorId])
}

model KamusEntry {
  id          String @id @default(cuid())
  kata        String
  slug        String @unique
  jenisKata   String?
  definisi    String
  contoh      String?
  sinonim     String?
  antonim     String?
  serapanDari String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kata])
  @@index([slug])
}

