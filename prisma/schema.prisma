  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  user                     User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([midtransSubscriptionId])
}

model AdminPaymentAuditLog {
  id            String   @id @default(cuid())
  adminUserId   String
  targetUserId  String?
  transactionId String?
  action        String   // MANUAL_ACTIVATE
  previousValue String?
  newValue      String?
  reason        String?
  metadata      Json?
  createdAt     DateTime @default(now())

  admin       User       @relation("PaymentAdminActions", fields: [adminUserId], references: [id], onDelete: Cascade)
  target      User?      @relation("PaymentTargetActions", fields: [targetUserId], references: [id], onDelete: SetNull)
  transaksi   Transaksi? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([adminUserId])
  @@index([targetUserId])
  @@index([transactionId])
  @@index([action])
  @@index([createdAt])
}

model AdminQuotaAuditLog {
  id            String   @id @default(cuid())
  adminUserId   String
  targetUserId  String
  action        String   // EXTEND_TRIAL, RESET_CREDITS, ALLOCATE_CREDITS
  amount        Int?
  previousValue String?
  newValue      String?
  reason        String?
  metadata      Json?
  createdAt     DateTime @default(now())

  admin  User @relation("AdminActions", fields: [adminUserId], references: [id], onDelete: Cascade)
  target User @relation("TargetActions", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([targetUserId])
  @@index([action])
  @@index([createdAt])
}

enum BackupTrigger {
  MANUAL
  SCHEDULED
  PRE_DEPLOY
  POST_RECOVERY
}

enum BackupStatus {
  SUCCESS
  FAILED
  PARTIAL
}

model BackupManifest {
  id              String        @id @default(cuid())
  backupId        String        @unique
  storagePath     String
  localPath       String?
  environment     String        @default("production")
  status          BackupStatus
  trigger         BackupTrigger @default(MANUAL)
  tableCountsJson String
  checksumsJson   String
  totalRows       Int
  totalTables     Int
  totalBytes      Int?
  startedAt       DateTime
  completedAt     DateTime
  errorMessage    String?
  createdByUserId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  createdBy User? @relation("UserBackupManifests", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([status])
  @@index([trigger])
}
