// ─── ARENA JUNIOR: AKUN MURID TK–SD ────────────────────────────
// Anak TK–SD tidak bisa mengetik email dan tidak bisa mengingat kata sandi.
// Karena itu gurunya yang mendaftarkan, dan anak masuk dengan cara: pilih
// kelas → ketuk namanya → PIN 4 angka.
//
// Di balik layar tetap memakai Supabase Auth: setiap anak punya email sintetis
// yang tidak pernah dilihatnya, dan kata sandi Supabase-nya diturunkan dari PIN
// (PIN 4 angka sendiri di bawah batas minimum Supabase).
//
// PIN 4 angka = 10.000 kemungkinan, jadi penguncian setelah beberapa kali salah
// WAJIB ada. Penghitungnya disimpan di sini, BUKAN di Redis — limiter berbasis
// Redis di repo ini mati bila env UPSTASH_*/KV_* tidak diset, dan kalau itu
// terjadi PIN jadi tanpa pengaman sama sekali.
model ArenaJuniorAkun {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Email sintetis untuk Supabase Auth. Anak tidak pernah melihat ini.
  emailSintetis String @unique

  /// Berapa kali PIN salah berturut-turut. Direset saat berhasil masuk.
  gagalPin       Int       @default(0)
  /// Selama waktu ini belum lewat, percobaan PIN ditolak tanpa diperiksa.
  terkunciSampai DateTime?
  terakhirMasuk  DateTime?

  /// Guru yang mendaftarkan anak ini.
  dibuatOlehId String
  dibuatOleh   User   @relation("ArenaJuniorPendaftar", fields: [dibuatOlehId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dibuatOlehId])
}

// ════════════════════════════════════════════════════════════════════
// BC ARENA CORE ENGINE — GAMIFICATION UNIVERSAL
// ────────────────────────────────────────────────────────────────────
// Fondasi sistem gamification yang dipakai seluruh fitur BahasaCerdas
// (Jalur Cerdas, Arena, Karya, UKBI/TKA, Penugasan, AI, dll).
//
// SEMUA tabel di bawah ini baru (additive-only) — tidak menyentuh model
// yang sudah ada, sehingga zero breaking changes terhadap fitur yang
// sudah berjalan. Data XP/koin lama (User.xp, User.coins, XpLedger,
// CoinTransaction) tetap dipakai fitur eksisting.
//
// Prinsip:
//   - PlayerProfile adalah "kartu pemain" universal, terpisah dari User.
//   - XP dicatat 1:1 ke XPTransaction (audit lengkap, idempotent).
//   - Level/Rank dihitung otomatis dari totalXP (tidak pernah hardcode).
//   - Badge & Achievement otomatis diberikan/dilacak lewat kondisi JSON.
//   - Weekly season reset weeklyXP; rank/level/coin/badge tidak terpengaruh.
// ════════════════════════════════════════════════════════════════════

/// Profil pemain universal (terpisah dari User agar eksisting tidak berubah).
model PlayerProfile {
  id     String @id @default(cuid())
  userId String @unique

  level       Int        @default(1)
  totalXP     Int        @default(0)
  currentRank PlayerRank @default(BRONZE)
  coin        Int        @default(0)

  /// XP terkumpul di minggu berjalan (direset tiap Senin 00:00 WIB).
  weeklyXP        Int    @default(0)
  /// Penanda minggu saat weeklyXP terakhir direset (format "2026-W31").
  weeklyXPWeekKey String @default("")

  /// XP terkumpul di season berjalan (season = periode kompetisi 4 mingguan).
  seasonXP        Int     @default(0)
  seasonId        String?
  /// Periode season aktif ("2026-S1", "2026-S2", ...).
  seasonPeriodKey String  @default("")

  /// Streak harian (login / aktivitas berturut-turut).
  streak       Int       @default(0)
  lastActiveAt DateTime?

  avatar String?
  frame  String?
  title  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  xpTransactions XPTransaction[]

  @@index([totalXP])
  @@index([weeklyXP])
  @@index([seasonXP])
  @@index([currentRank])
}

/// Ledger XP universal — SETIAP pemberian XP dicatat di sini (audit penuh).
model XPTransaction {
  id        String @id @default(cuid())
  userId    String
  profileId String

  /// Sumber XP: JALUR_CERDAS, ARENA, KARYA_SISWA, ARTIKEL, UKBI, TKA,
  /// PENUGASAN, AI, GAME, DAILY_QUEST, BADGE, ACHIEVEMENT, SYSTEM.
  source    String
  amount    Int
  /// Metadata tambahan (JSON bebas: { unitId, paketId, karyaId, ... }).
  metadata  Json?
  /// Referensi idempotency — kombinasi (userId, source, reference) unik,
  /// sehingga XP tidak bisa digandakan oleh retry/klik ganda.
  reference String?
  createdAt DateTime @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([userId, source, reference])
  @@index([userId, createdAt])
  @@index([profileId, createdAt])
  @@index([source])
}

/// Definisi badge (diseed, kondisi dalam JSON).
model Badge {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  icon        String
  description String
  /// JSON kondisi: { type: "TOTAL_XP"|"LEVEL"|"STREAK"|"WEEKLY_XP"|"SEASON_XP"|"COIN_BALANCE"|"TOTAL_KARYA"|"DAYS_ACTIVE"|"XP_SOURCE_TOTAL", target: N, source? }
  condition   Json
  rarity      BadgeRarity @default(BRONZE)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())

  users UserBadge[]

  @@index([isActive])
}

/// Badge yang sudah diraih user.
model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([badgeId])
}

/// Definisi achievement (diseed).
model Achievement {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  icon        String
  description String
  target      Int
  /// Reward saat achievement selesai & diklaim.
  rewardXP    Int      @default(0)
  rewardCoins Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  users UserAchievement[]

  @@index([isActive])
}

/// Progress achievement per user (realtime, bisa diklaim).
model UserAchievement {
  id            String    @id @default(cuid())
  userId        String
  achievementId String
  progress      Int       @default(0)
  completed     Boolean   @default(false)
  claimed       Boolean   @default(false)
  claimedAt     DateTime?
  updatedAt     DateTime  @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([achievementId])
}

/// Season mingguan untuk leaderboard weekly.
model WeeklySeason {
  id        String   @id @default(cuid())
  weekKey   String   @unique // "2026-W31"
  label     String
  startsAt  DateTime
  endsAt    DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([isActive])
}

/// Hasil settlement podium kompetisi BC Arena (weekly/season) — sumber Hall of
/// Fame. Baris dibuat SEKALI per (periodType, periodKey, userId) saat periode
/// ditutup (lazy settle, tanpa cron). Reward XP podium sengaja TIDAK masuk
/// weeklyXP/seasonXP agar tidak terjadi loop (no XP snowball antarminggu);
/// ia hanya menambah XP total lewat ledger yang sama.
model LeaderboardPeriodResult {
  id         String   @id @default(cuid())
  periodType String // "WEEKLY" | "SEASON"
  periodKey  String // "2026-W31" | "2026-S1"
  userId     String
  rank       Int // 1..3
  score      Int // XP yang menjadi dasar ranking (weeklyXP/seasonXP periode tsb)
  rewardXp   Int
  rewardCoins Int
  badgeCode  String?
  settledAt  DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([periodType, periodKey, userId])
  @@index([periodType, periodKey])
  @@index([userId])
}

/// Skill bahasa per user (level 1-100, computed dari skill xp).
/// Dipakai Learning Loop Engine untuk rekomendasi & CTA.
model LearningSkill {
  id        String            @id @default(cuid())
  userId    String
  skill     LearningSkillType
  /// Level 1-100 (computed dari `xp` via skillLevelFromXp).
  level     Int               @default(1)
  /// Akumulasi XP skill.
  xp        Int               @default(0)
  updatedAt DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skill])
  @@index([userId])
}

/// Log granular aktivitas belajar user — sumber Learning Journey, skill
/// gain, personalisasi quest, dan insight mentor.
model PlayerActivity {
  id         String             @id @default(cuid())
  userId     String
  type       ActivityType
  subtype    String?
  skill      LearningSkillType?
  skillDelta Int?
  xp         Int                @default(0)
  coin       Int                @default(0)
  /// Metadata bebas (unitId, paketId, karyaId, ...).
  meta       Json?
  /// Referensi idempotency opsional (mis. "unit-<id>-selesai").
  reference  String?
  createdAt  DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, type])
  @@index([type, createdAt])
}

/// Timeline belajar per hari (diagregasi untuk tampilan "Perjalanan Belajar").
model LearningJourney {
  id          String       @id @default(cuid())
  userId      String
  /// "2026-08-01" (WIB).
  dayKey      String
  type        ActivityType
  title       String
  description String?
  icon        String?
  meta        Json?
  createdAt   DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayKey])
  @@index([userId, createdAt])
}

/// Rekomendasi belajar per user (aktif maksimal 3, kedaluwarsa per periode).
model LearningRecommendation {
  id          String             @id @default(cuid())
  userId      String
  type        RecommendationType
  skill       LearningSkillType?
  priority    Int                @default(50)
  title       String
  description String
  ctaLabel    String
  ctaHref     String
  reason      String?
  isActive    Boolean            @default(true)
  expiresAt   DateTime?
  createdAt   DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([userId, createdAt])
}

/// CTA "Aksi Berikutnya" — satu baris terbaik yang ditampilkan di semua
/// layar completion supaya tidak ada dead end.
model PlayerCTA {
  id          String   @id @default(cuid())
  userId      String   @unique
  ctaType     String
  title       String
  description String
  ctaLabel    String
  ctaHref     String
  priority    Int      @default(50)
  meta        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Insight harian berbasis aturan ("mentor") — cache agar tidak dihitung ulang.
model LearningInsight {
  id        String   @id @default(cuid())
  userId    String
  /// "2026-08-01" (WIB).
  dayKey    String
  insights  Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayKey])
}

/// Evidence question-level yang diverifikasi server. Ini bukan XP, mastery,
/// atau learner state; hanya catatan apa yang dijawab dan hasil validasinya.
model LearningEvidence {
  id             String            @id @default(cuid())
  userId         String
  source         String
  activityId     String
  questionId     String
  selectedAnswer String?
  isCorrect      Boolean?
  score          Float?
  skill          LearningSkillType?
  difficulty     Difficulty?
  answeredAt     DateTime          @default(now())
  metadata       Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Satu soal dalam satu aktivitas adalah satu evidence yang idempoten.
  @@unique([userId, source, activityId, questionId])
  @@index([userId, answeredAt])
  @@index([userId, questionId])
  @@index([userId, source, answeredAt])
  @@index([userId, skill, answeredAt])
}

/// Langganan Web Push milik satu perangkat. Satu murid bisa punya beberapa:
/// HP sendiri, tablet kelas, browser di rumah. Endpoint unik per perangkat dan
/// itulah identitasnya — bukan userId.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  /// URL push service dari browser. Unik: browser memberi endpoint sama untuk
  /// perangkat yang sama, jadi ini mencegah duplikat saat murid membuka ulang app.
  endpoint  String   @unique
  p256dh    String
  auth      String
  /// Dipakai untuk membersihkan langganan mati. Push service mengembalikan 404/410
  /// kalau perangkat sudah mencabut izin; saat itu barisnya dihapus.
  createdAt DateTime @default(now())
  lastOkAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
