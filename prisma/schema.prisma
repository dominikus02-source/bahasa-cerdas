  targetId  String
  createdAt DateTime @default(now())

  liker  User @relation("ProfileLikeLiker", fields: [likerId], references: [id], onDelete: Cascade)
  target User @relation("ProfileLikeTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([likerId, targetId])
  @@index([targetId])
  @@index([likerId])
}

