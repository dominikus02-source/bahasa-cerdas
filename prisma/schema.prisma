  nama           String?
  deskripsi      String?
  hargaFixed     Int? // harga akhir tetap (mis. Rp 1.000 untuk Program Guru Cerdas)
  diskonPersen   Int? // alternatif: persen potongan dari harga asli
  hargaMinimal   Int? // floor harga akhir saat memakai diskonPersen (~Rp 1.000 Midtrans)
  planId         String? // batasan paket (null = berlaku untuk semua paket)
  untukRole      String    @default("GURU") // "*" = semua role
  mulaiBerlaku   DateTime?
  berakhirPada   DateTime?
  batasPemakaian Int? // null = tanpa batas
  jumlahTerpakai Int       @default(0)
  aktif          Boolean   @default(true)
  dibuatOleh     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

