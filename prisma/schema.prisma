generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model GameRoom {
  id                 String         @id @default(cuid())
  code               String         @unique
  name               String
  gameType           GameType       @default(KUIS_BATTLE)
  hostId             String
  status             GameRoomStatus @default(WAITING)
  category           String?
  difficulty         Difficulty     @default(MEDIUM)
  questionIds        String[]
  questionCount      Int            @default(10)
  timePerQuestion    Int            @default(20)
  currentQuestion    Int            @default(0)
  createdAt          DateTime       @default(now())
  startedAt          DateTime?
  endedAt            DateTime?
  groupId            String? // for penilaian integration
  includeInPenilaian Boolean        @default(false)
  penilaianKategori  String?
  results            GameResult[]
  sessions           GameSession[]

  @@index([code])
  @@index([hostId])
  @@index([groupId])
}

model GameQuestion {
  id            String           @id @default(cuid())
  gameRoomId    String?
  text          String
  audioUrl      String?
  imageUrl      String?
  passage       String?
  type          GameQuestionType @default(PILIHAN_GANDA)
  options       Json
  correctAnswer String
  explanation   String?
  difficulty    Difficulty       @default(MEDIUM)
  orderIndex    Int              @default(0)
  uploaderId    String?
  createdAt     DateTime         @default(now())
  uploader      User?            @relation(fields: [uploaderId], references: [id])

  @@index([gameRoomId])
}

model GameSession {
  id          String      @id @default(cuid())
  roomId      String
  userId      String
  playerName  String
  avatarUrl   String?
  score       Int         @default(0)
  correct     Int         @default(0)
  wrong       Int         @default(0)
  streak      Int         @default(0)
  maxStreak   Int         @default(0)
  answerTimes Int[]       @default([])
  joinedAt    DateTime    @default(now())
  finishedAt  DateTime?
  result      GameResult?
  room        GameRoom    @relation(fields: [roomId], references: [id])
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

model GameResult {
  id         String      @id @default(cuid())
  roomId     String
  userId     String
  sessionId  String      @unique
  finalScore Int         @default(0)
  rank       Int?
  correct    Int
  wrong      Int
  maxStreak  Int
  avgTime    Float
  xpEarned   Int         @default(0)
  createdAt  DateTime    @default(now())
  room       GameRoom    @relation(fields: [roomId], references: [id])
  session    GameSession @relation(fields: [sessionId], references: [id])
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([userId])
  @@index([rank, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([createdAt, userId, xpEarned]) // daily league groupBy(userId) sum(xpEarned)
}

model Community {
  id          String            @id @default(cuid())
  name        String
  description String?
  type        CommunityType     @default(MGMP)
  region      String?
  province    String?
  city        String?
  school      String?
  avatarUrl   String?
  bannerUrl   String?
  isPublic    Boolean           @default(true)
  isVerified  Boolean           @default(false)
  memberCount Int               @default(0)
  postCount   Int               @default(0)
  creatorId   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  attachments Json?
  reviewNote  String?
  reviewedAt  DateTime?
  reviewedBy  String?
  status      CommunityStatus   @default(PENDING)
  creator     User?             @relation(fields: [creatorId], references: [id])
  members     CommunityMember[]
  posts       CommunityPost[]

  @@index([type])
  @@index([isPublic])
  @@index([status])
}

model CommunityMember {
  id          String    @id @default(cuid())
  communityId String
  userId      String
  role        String    @default("member")
  joinedAt    DateTime  @default(now())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([userId])
}

model CommunityPost {
  id            String    @id @default(cuid())
  communityId   String
  userId        String
  title         String?
  content       String
  fileUrl       String?
  likesCount    Int       @default(0)
  commentsCount Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  community     Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([communityId])
  @@index([userId])
  @@index([createdAt])
}

model User {
  id                    String                  @id @default(cuid())
  supabaseId            String                  @unique
  email                 String                  @unique
  fullName              String
  nickname              String?
  nicknameUpdatedAt     DateTime?
  avatar                String?
  emailConfirmed        Boolean                 @default(false)
  onboarded             Boolean                 @default(false)
  role                  Role                    @default(MURID)
  isFounder             Boolean                 @default(false)
  premiumPlan           PremiumPlan             @default(FREE)
  premiumUntil          DateTime?
  isPremium             Boolean                 @default(false)
  midtransCustomerId    String?
  trialStartedAt        DateTime?
  trialEndsAt           DateTime?
  trialPlan             String? // "GURU_PRO_TRIAL" if trial is active
  trialCreditsTotal     Int? // total credits allocated for trial
  xp                    Int                     @default(0)
  level                 Int                     @default(1)
  streak                Int                     @default(0)
  lastActiveAt          DateTime?
  /// USANG — jangan dibaca/ditulis. Liga 4 tingkat digantikan 9 rank resmi.
  /// Enum LeagueType tidak akan pernah bisa menampung PlayerRank (9 nilai).
  /// Rank pemain ada di PlayerProfile.currentRank, atau turunkan langsung:
  /// rankFromLevel(levelFromXp(User.xp)). Kolom dibiarkan agar baris lama tidak
  /// perlu migrasi destruktif; nilainya beku dan tidak dipakai di mana pun.
  league                LeagueType              @default(BRONZE)
  saldo                 Int                     @default(0)
  totalEarned           Int                     @default(0)
  coins                 Int                     @default(0)
  // Kosmetik yang sedang dipakai. Isinya `icon` dari StoreItem yang dimiliki
  // (mis. "frame-gold", "color-purple"), null artinya tidak memakai apa pun.
  equippedFrame         String?
  equippedNameColor     String?
  equippedBadge         String?
  equippedEffect        String?
  totalLikes            Int                     @default(0)
  totalViews            Int                     @default(0)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  aiUsage               AIUsage[]
  aiCreditLedger        AiCreditLedger[]
  artikel               Artikel[]
  uploadedBankSoals     BankSoal[]
  certificates          Certificate[]
  createdCommunities    Community[]
  komunitas             CommunityMember[]
  communityPosts        CommunityPost[]
  playlists             CoursePlaylist[]
  gameQuestions         GameQuestion[]
  gameResults           GameResult[]
  gameSessions          GameSession[]
  generatedRPPs         GeneratedRPP[]
  aiJobs                AIJob[]
  aiSavedResults        AiSavedResult[]
  groups                Group[]
  groupMemberships      GroupMember[]
  groupQuizResults      GroupQuizResult[]
  karya                 Karya[]
  studentKarya          StudentKarya[]
  studentKaryaLikes     StudentKaryaLike[]
  studentKaryaComments  StudentKaryaComment[]
  artikelLikes          ArtikelLike[]
  artikelComments       ArtikelComment[]
  koleksiKata           KoleksiKata[]
  competencyCerts       KompetensiCertificate[]
  loker                 Loker[]
  lombaPeserta          LombaPeserta[]
  uploadedMateris       Materi[]
  materiDownloads       MateriDownload[]
  notifications         Notifikasi[]
  competencyPackets     PaketKompetensi[]
  purchases             Pembelian[]
  profile               Profile?
  competencyResults     ProgresKompetensi[]
  purchasesHistory      PurchaseHistory[]
  quizzes               Quiz[]
  quizSessions          QuizSession[]
  quizSubmissions       QuizSubmission[]
  uploadedRPPs          RPP[]
  sellerEarnings        SellerEarning[]
  soals                 Soal[]
  soalSets              SoalSet[]
  tkaQuestions          TKAQuestion[]
  testAnswers           TestAnswer[]
  testSessions          TestSession[]
  transaksi             Transaksi[]
  ukbiQuestions         UKBIQuestion[]
  videos                Video[]
  withdrawals           Withdrawal[]
  coinTransactions      CoinTransaction[]
  xpLedger              XpLedger[]
  dailyQuests           DailyQuest[]
  userItems             UserItem[]
  pushSubscriptions     PushSubscription[]
  chatMessages          ChatMessage[]
  unitProgress          UserUnitProgress[]
  penugasans            Penugasan[]
  penugasanSubmissions  PenugasanSubmission[]
  nilais                Nilai[]
  subscriptions         Subscription[]
  nicknameHistory       NicknameHistory[]
  materiKirims          MateriKirim[]
  pengumumanDibuat      Pengumuman[]            @relation("PengumumanTeacher")
  siaranDibuat          Siaran[]                @relation("SiaranAuthor")
  pengumumanSubmissions PengumumanSubmission[]
  kuponDipakai          KuponPemakaian[]

  // BC Arena Core Engine (universal gamification — PlayerProfile terpisah dari User)
  playerProfile    PlayerProfile?
  xpTransactions   XPTransaction[]
  userBadges       UserBadge[]
  userAchievements UserAchievement[]
  // BC Premium Economy Foundation (fase P1)
  premiumUsage     PremiumUsage[]
  // Leaderboard Motivation Layer — hasil settlement podium (weekly/season) + Hall of Fame.
  leaderboardPeriodResults LeaderboardPeriodResult[]

  // Learning Loop Engine (Sprint 5 — aktivitas, skill, journey, rekomendasi, CTA, insight)
  learningSkills          LearningSkill[]
  playerActivities        PlayerActivity[]
  learningJourney         LearningJourney[]
  learningRecommendations LearningRecommendation[]
  playerCTA               PlayerCTA?
  learningInsights        LearningInsight[]
  learningEvidences       LearningEvidence[]

  // Admin quota audit logs where this user was the acting admin
  adminQuotaActions    AdminQuotaAuditLog[]   @relation("AdminActions")
// Admin quota audit logs where this user was the target
  targetOfQuotaActions AdminQuotaAuditLog[] @relation("TargetActions")
  // Admin payment audit logs where this user was the acting admin
  paymentAdminActions  AdminPaymentAuditLog[] @relation("PaymentAdminActions")
  // Admin payment audit logs where this user was the target
  paymentTargetActions AdminPaymentAuditLog[] @relation("PaymentTargetActions")
  // Backup manifests created by this user
  backupManifests      BackupManifest[]       @relation("UserBackupManifests")
  // Arena Junior (TK-SD) lesson progress
  arenaJuniorProgress  ArenaJuniorProgress[]
  arenaJuniorAkun      ArenaJuniorAkun?
  arenaJuniorDidaftar  ArenaJuniorAkun[]      @relation("ArenaJuniorPendaftar")

  // Sosial profil (Player Identity — Phase profil murid premium)
  // following = yang user ini ikuti, followers = yang mengikuti user ini.
  following  Follow[]        @relation("Following")
  followers  Follow[]        @relation("Followers")
  profileLikesGiven  ProfileLike[] @relation("ProfileLikeLiker")
  profileLikesReceived ProfileLike[] @relation("ProfileLikeTarget")

  @@index([role, lastActiveAt])
  @@index([xp])
  @@index([role, xp]) // leaderboard: role=MURID ORDER BY xp DESC
  @@index([lastActiveAt]) // monitoring: active users in last N minutes
  @@index([supabaseId])
  @@index([email])
}

model Profile {
  id         String   @id @default(cuid())
  userId     String   @unique
  bio        String?
  nip        String?
  nuptk      String?
  nisn       String?
  noAbsen    String?
  school     String?
  // Identitas kanonik sekolah (P1-C). NULL = belum dipetakan; `school` tetap
  // menyimpan nilai mentah user. DUAL IDENTITY disengaja:
  //   school   = legacy/raw user-entered value (display, backward compat)
  //   schoolId = canonical identity (School)
  // schoolId TIDAK pernah menjadi dasar authorization — hanya identitas/agregasi.
  schoolId    String?
  city       String?
  province   String?
  subject    String?
  grade      String?
  className  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  bank       String?
  bankHolder String?
  bankNumber String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolRef  School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([schoolId])
}

// Identitas kanonik sekolah (P1-C — OPTION B). canonicalName = nama resmi yang
// ditampilkan; normalizedName = representasi deterministik untuk lookup/index.
// School dibuat hanya lewat proses eksplisit yang dipercaya (bukan auto-create
// dari DISTINCT Profile.school). `isActive=false` = nonaktif (bukan hapus).
model School {
  id             String        @id @default(cuid())
  canonicalName  String
  normalizedName String
  province       String?
  city           String?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  aliases        SchoolAlias[]
  profiles       Profile[]

  @@index([normalizedName])
  @@index([city])
  @@index([province])
}

// Alias eksplisit untuk satu School. normalizedAlias UNIK agar satu alias
// normalisasi tidak pernah menunjuk ke >1 sekolah (aturan §6.2).
// Alias tidak dibuat otomatis dari seluruh Profile.school tanpa keputusan.
model SchoolAlias {
  id              String   @id @default(cuid())
  schoolId        String
  alias           String
  normalizedAlias String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([normalizedAlias])
  @@index([schoolId])
}

model NicknameHistory {
  id          String   @id @default(cuid())
  userId      String
  oldNickname String?
  newNickname String?
  changedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([changedAt])
}

model UKBIQuestion {
  id            String             @id @default(cuid())
  seksi         UKBISeksi
  text          String
  audioUrl      String?
  imageUrl      String?
  passage       String?
  type          String             @default("PILIHAN_GANDA")
  options       Json
  correctAnswer String
  explanation   String?
  difficulty    Difficulty         @default(MEDIUM)
  cognitive     CognitiveDimension @default(PENERAPAN)
  domain        KommunikasDomain   @default(SOSIAL)
  passageType   String?
  wordCount     Int?
  keywords      String[]
  isActive      Boolean            @default(true)
  isVerified    Boolean            @default(false)
  uploaderId    String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  tingkat       Tingkat            @default(UMUM)
  uploader      User?              @relation(fields: [uploaderId], references: [id])

  @@index([seksi, isActive])
  @@index([difficulty])
  @@index([isVerified])
  @@index([tingkat])
}

model TKAQuestion {
  id            String        @id @default(cuid())
  kompetensi    TKAKompetensi
  subKompetensi String?
  text          String
  passage       String?
  type          String        @default("PILIHAN_GANDA")
  options       Json
  correctAnswer String
  explanation   String?
  difficulty    Difficulty    @default(MEDIUM)
  weight        Float         @default(1.0)
  year          Int?
  source        String?
  isActive      Boolean       @default(true)
  isVerified    Boolean       @default(false)
  uploaderId    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  tingkat       Tingkat       @default(UMUM)
  uploader      User?         @relation(fields: [uploaderId], references: [id])

  @@index([kompetensi, isActive])
  @@index([difficulty])
  @@index([isVerified])
  @@index([tingkat])
}

model PaketKompetensi {
  id             String                  @id @default(cuid())
  title          String
  description    String?
  type           KompetensiType
  mode           TestMode                @default(SIMULASI)
  duration       Int
  passingScore   Int                     @default(0)
  passingGrade   String                  @default("D")
  sections       Json
  totalQuestions Int                     @default(0)
  isActive       Boolean                 @default(true)
  isPremium      Boolean                 @default(false)
  thumbnailUrl   String?
  attemptLimit   Int                     @default(-1)
  sectionsData   Json?
  questionPool   Json?
  creatorId      String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  certificates   KompetensiCertificate[]
  creator        User?                   @relation(fields: [creatorId], references: [id])
  results        ProgresKompetensi[]
  testSessions   TestSession[]

  @@index([type, isActive])
  @@index([type, isActive, createdAt])
}

model ProgresKompetensi {
  id            String          @id @default(cuid())
  userId        String
  paketId       String
  attemptNumber Int             @default(1)
  status        TestStatus      @default(NOT_STARTED)
  totalScore    Int?
  rawScore      Int?
  maxScore      Int?
  percentage    Float?
  predikat      String?
  predikatLama  String?
  sectionScores Json?
  seksiScores   Json?
  answerDetails Json?
  startedAt     DateTime        @default(now())
  finishedAt    DateTime?
  timeSpent     Int?
  paket         PaketKompetensi @relation(fields: [paketId], references: [id])
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, paketId, attemptNumber])
  @@index([userId])
  @@index([paketId])
  @@index([userId, status])
}

model KompetensiCertificate {
  id            String          @id @default(cuid())
  userId        String
  paketId       String
  progresId     String
  score         Int
  predikat      String
  percentage    Float
  qrCode        String?
  certificateNo String          @unique
  pdfUrl        String?
  issuedAt      DateTime        @default(now())
  expiresAt     DateTime?
  paket         PaketKompetensi @relation(fields: [paketId], references: [id])
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TestSession {
  id               String          @id @default(cuid())
  userId           String
  paketId          String
  status           TestStatus      @default(NOT_STARTED)
  currentSection   Int             @default(0)
  currentQuestion  Int             @default(0)
  answers          Json            @default("{}")
  questionSnapshot Json?
  flagged          Int[]           @default([])
  startedAt        DateTime?
  finishedAt       DateTime?
  expiresAt        DateTime?
  createdAt        DateTime        @default(now())
  paket            PaketKompetensi @relation(fields: [paketId], references: [id])
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, paketId])
  @@index([userId])
  @@index([paketId])
  @@index([userId, status])
  @@index([paketId, status])
}

model TestAnswer {
  id            String    @id @default(cuid())
  userId        String
  sessionId     String?
  paketId       String?
  questionId    String?
  questionType  String?
  answer        String?
  isCorrect     Boolean?
  score         Float     @default(0)
  timeSpent     Int       @default(0)
  seksi         String?
  sectionIndex  Int       @default(0)
  aiFeedback    Json? // Analysis: {ringkasan, nilai, rubrik[], kelebihan[], kelemahan[], kesalahanTerbesar[], kompetensiBelum[], rekomendasi[], komentarGuru, komentarMurid, dimensi}
  aiConfidence  Float? // 0-100 percaya diri AI
  aiReviewedAt  DateTime?
  reviewStatus  String? // PENDING / MENUNGGU_PERSETUJUAN / DISETUJUI / DIEDIT
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, paketId])
  @@index([sessionId])
}

model Materi {
  id              String           @id @default(cuid())
  title           String
  description     String?
  content         String
  fileUrl         String?
  fileKey         String?
  fileType        FileType?
  grade           String?
  semester        Int?
  tahunAjaran     String?
  tema            String?
  subtema         String?
  isPublished     Boolean          @default(false)
  isPremium       Boolean          @default(false)
  price           Int              @default(0)
  downloads       Int              @default(0)
  subject         String?
  uploaderId      String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  uploader        User             @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  downloadRecords MateriDownload[]
  kirims          MateriKirim[]

  @@index([uploaderId])
  @@index([isPublished])
}

// Catatan unduhan per user — untuk batas unduh (gratis 10 modul, premium tak terbatas).
model MateriDownload {
  id        String   @id @default(cuid())
  userId    String
  materiId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  materi    Materi   @relation(fields: [materiId], references: [id], onDelete: Cascade)

  @@unique([userId, materiId])
  @@index([userId])
  @@index([materiId])
}

// Guru mengirim satu Materi (file) ke satu kelas — riwayat kirim + sumber
// daftar "Materi dari Guru" di sisi murid.
model MateriKirim {
  id        String   @id @default(cuid())
  materiId  String
  groupId   String
  teacherId String
  createdAt DateTime @default(now())

  materi  Materi @relation(fields: [materiId], references: [id], onDelete: Cascade)
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacher User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([materiId, groupId])
  @@index([groupId])
  @@index([materiId])
  @@index([teacherId])
}

model BankSoal {
  id          String     @id @default(cuid())
  title       String
  description String?
  type        String     @default("PILIHAN_GANDA")
  difficulty  Difficulty @default(MEDIUM)
  kelas       String
  semester    Int?
  tahunAjaran String?
  KD          String?
  isHOTS      Boolean    @default(false)
  jumlahSoal  Int        @default(10)
  fileUrl     String
  fileKey     String?
  fileType    FileType   @default(PDF)
  isPublished Boolean    @default(false)
  isPremium   Boolean    @default(false)
  price       Int        @default(0)
  downloads   Int        @default(0)
  subject     String     @default("Bahasa Indonesia")
  uploaderId  String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  uploader    User       @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  soals       Soal[]

  @@index([uploaderId])
  @@index([isPublished])
}

model Soal {
  id             String    @id @default(cuid())
  kodeSoal       String?   @unique
  judul          String?
  text           String
  type           String    @default("PILIHAN_GANDA")
  difficulty     String    @default("MEDIUM")
  options        String[]
  correctAnswer  String
  explanation    String?
  isHOTS         Boolean   @default(false)
  kelas          String
  semester       Int?
  topik          String?
  kompetensi     String?
  indikator      String?
  levelBerpikir  Int?
  kataKunci      String?
  estimasiWaktu  Int?
  KD             String?
  subject        String    @default("Bahasa Indonesia")
  source         String    @default("MANUAL")
  bankSoalId     String?
  soalSetId      String?
  uploaderId     String
  usedCount      Int       @default(0)
  correctCount   Int       @default(0)
  wrongCount     Int       @default(0)
  totalTimeSpent Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  bankSoal       BankSoal? @relation(fields: [bankSoalId], references: [id])
  soalSet        SoalSet?  @relation(fields: [soalSetId], references: [id])
  uploader       User      @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([uploaderId])
  @@index([kelas])
  @@index([topik])
  @@index([source])
  @@index([kodeSoal])
  @@index([soalSetId])
}

model SoalSet {
  id           String   @id @default(cuid())
  title        String
  description  String?
  coverColor   String   @default("from-violet-500 to-purple-600")
