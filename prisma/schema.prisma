// ── Sosial Profil (Player Identity — profil murid premium) ────────────────
// Follow: relasi satu arah follower→following (idempoten via @@unique).
// ProfileLike: "Suka profil" — terpisah dari like karya (StudentKaryaLike).
// Migration: prisma/migrations/manual/2026-08-10_profile_follow.sql (idempoten).

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@index([followerId])
}

model ProfileLike {
  id        String   @id @default(cuid())
