# Database connection string for the game server.
# This is a LONG-LIVED server that holds connections open, so use the Supabase
# SESSION pooler (port 5432) or a direct connection — NOT the transaction pooler
# (port 6543), which is meant for short serverless requests.
DATABASE_URL=[Supabase session pooler :5432 or direct connection]

# Port for the Socket.io game server
GAME_PORT=3001
