# Runtime
NODE_ENV=production
GAME_PORT=3001

# Browser origins allowed to establish Socket.IO / WebSocket connections.
# Add staging explicitly when needed, comma-separated.
GAME_ALLOWED_ORIGINS=https://www.bahasacerdas.com,https://bahasacerdas.com

# Authenticated bridge back to the BahasaCerdas web app.
BAHASACERDAS_WEB_URL=https://www.bahasacerdas.com
KUIS_TEMPUR_SERVER_SECRET=replace-with-a-long-random-secret

# Legacy realtime game modes still use Prisma directly.
# Kuis Tempur Arena itself uses the authenticated web bridge above and does not
# require direct production DB access.
DATABASE_URL=postgresql://user:password@host:5432/database
