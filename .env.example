# Web origin; never derive recovery redirects from the request's Host header.
APP_URL=https://bahasacerdas.com
NEXT_PUBLIC_SITE_URL=https://bahasacerdas.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
# Recovery requires shared Redis in production (atomic per-email and IP limits).
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token
# Configure these in Supabase Dashboard SMTP, NOT only in the web host.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=your-resend-api-key
EMAIL_FROM=BahasaCerdas <noreply@bahasacerdas.com>
# Must be provisioned/monitored before launch. Native Supabase SMTP does not
# expose an arbitrary Reply-To setting; see docs/EMAIL_DELIVERABILITY.md.
EMAIL_REPLY_TO=dukungan@bahasacerdas.com
SUPPORT_EMAIL=dukungan@bahasacerdas.com
