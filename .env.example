# Web origin; never derive recovery redirects from the request's Host header.
APP_URL=https://bahasacerdas.com
NEXT_PUBLIC_SITE_URL=https://bahasacerdas.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
# Recovery requires shared Redis in production (atomic per-email and IP limits).
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token
# Configure these in Supabase Dashboard SMTP, NOT only in the web host.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=your-resend-api-key
EMAIL_FROM=BahasaCerdas <noreply@bahasacerdas.com>
# Must be provisioned/monitored before launch. Native Supabase SMTP does not
# expose an arbitrary Reply-To setting; see docs/EMAIL_DELIVERABILITY.md.
EMAIL_REPLY_TO=dukungan@bahasacerdas.com
SUPPORT_EMAIL=dukungan@bahasacerdas.com

# Premium Umum (lihat docs/UMUM_PREMIUM.md)
# Penjualan paket Premium Umum di checkout. Default mati; webhook tetap memproses pesanan yang sudah dibuat.
ENABLE_UMUM_PREMIUM=false
# Rahasia HMAC untuk hash email/Google id di TrialClaim (uji coba sekali per orang). Jangan diganti setelah produksi berjalan.
TRIAL_CLAIM_HASH_SECRET=

# Roblox — BahasaCerdas Kota Aksara. Server permainan memanggil /api/roblox/* dengan
# Authorization: Bearer <ROBLOX_SERVER_SECRET>. Nilai secret sama dengan Secrets Store
# Roblox (BAHASACERDAS_ROBLOX_KEY). Jangan taruh di skrip klien.
# Nilai place/universe/URL di bawah adalah bawaan publik dan tetap bisa ditimpa.
# Universe 10778759021. Root place 83804286143888.
# https://www.roblox.com/games/83804286143888
ROBLOX_SERVER_SECRET=
ROBLOX_PLACE_ID=83804286143888
ROBLOX_UNIVERSE_ID=10778759021
ROBLOX_EXPERIENCE_URL=https://www.roblox.com/games/83804286143888
ROBLOX_EXPERIENCE_NAME="BahasaCerdas Kota Aksara"
# Gerbang usia. false, atau ROBLOX_MIN_AGE=0, membuka untuk semua usia. Bawaan 16+.
ROBLOX_AGE_GATE_ENABLED=true
ROBLOX_MIN_AGE=16
# Detik. Kode tautan sekali pakai, lalu masa berlaku sesi soal.
ROBLOX_LINK_CODE_TTL_SECONDS=600
ROBLOX_QUESTION_TTL_SECONDS=2700
# Selisih jam x-roblox-timestamp yang ditolak. Bawaan 5 menit. Butuh Redis untuk nonce.
ROBLOX_TIMESTAMP_SKEW_MS=300000

# JUMPA: batas semua ruang baru; default uji coba 30.
# Nilai 150 hanya setelah uji media/CPU/bandwidth/TURN pada server tujuan lulus.
# Mengubah ini tidak mengubah ruang aktif/lama yang batasnya tersimpan di DB.
JUMPA_MAX_PARTICIPANTS=30
