# syntax=docker/dockerfile:1.7

FROM node:22-bookworm-slim AS deps
ARG BUILD_CACHE_SCOPE=bahasacerdas-production
ARG TARGETOS
ARG TARGETARCH
WORKDIR /app
RUN apt-get update -y \
  && apt-get install -y --no-install-recommends ca-certificates openssl \
  && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN --mount=type=cache,id=${BUILD_CACHE_SCOPE}-node22-${TARGETOS}-${TARGETARCH}-npm,target=/root/.npm/_cacache,sharing=locked npm ci --prefer-offline --no-audit --no-fund

FROM node:22-bookworm-slim AS builder
ARG BC_BUILD_ENV=production
ENV BC_BUILD_ENV=$BC_BUILD_ENV
ARG BUILD_CACHE_SCOPE=bahasacerdas-production
ARG TARGETOS
ARG TARGETARCH
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
RUN apt-get update -y \
  && apt-get install -y --no-install-recommends ca-certificates openssl \
  && rm -rf /var/lib/apt/lists/*
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npx prisma generate
# The production env is mounted only for the build step. It is not copied into
# any image layer. NEXT_PUBLIC_* values are intentionally embedded by Next.js.
# BuildKit secrets do not invalidate cache by content, so this fingerprint lets
# deploys intentionally rebuild the Next layer when public build-time env changes.
ARG WEB_BUILD_FINGERPRINT=manual
RUN --mount=type=cache,id=${BUILD_CACHE_SCOPE}-node22-${TARGETOS}-${TARGETARCH}-webpack,target=/app/.next/cache/webpack,sharing=locked --mount=type=cache,id=${BUILD_CACHE_SCOPE}-node22-${TARGETOS}-${TARGETARCH}-turbopack,target=/app/.next/cache/turbopack,sharing=locked --mount=type=cache,id=${BUILD_CACHE_SCOPE}-node22-${TARGETOS}-${TARGETARCH}-swc,target=/app/.next/cache/swc,sharing=locked \
    --mount=type=secret,id=web_env,target=/app/.env.production,required=true \
  echo "web-build-fingerprint=${WEB_BUILD_FINGERPRINT}" >/tmp/web-build-fingerprint \
  && npm run build \
  && find .next/standalone -maxdepth 1 -type f -name '.env*' -delete \
  && test -z "$(find .next/standalone -maxdepth 1 -type f -name '.env*' -print -quit)"

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000

RUN apt-get update -y \
  && apt-get install -y --no-install-recommends ca-certificates openssl \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd --system --gid 1001 nodejs \
  && useradd --system --uid 1001 --gid nodejs nextjs

COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
